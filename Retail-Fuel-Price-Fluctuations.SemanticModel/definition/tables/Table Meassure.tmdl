	measure 'Score Change (Lowest)' =
			
			VAR YearlyMin =
			    FILTER(
			        SUMMARIZE(
			            ALL('OECD PISA data'),
			            'OECD PISA data'[TIME],
			            "MinScore", CALCULATE(
			                MIN('OECD PISA data'[Value]),
			                'OECD PISA data'[SUBJECT] = "TOT"
			            )
			        ),
			        NOT ISBLANK([MinScore])
			    )
			VAR SelectedYear = MAX('OECD PISA data'[TIME])
			VAR PrevYear = MAXX(FILTER(YearlyMin, [TIME] < SelectedYear), [TIME])
			VAR CurrentMin = MAXX(FILTER(YearlyMin, [TIME] = SelectedYear), [MinScore])
			VAR PrevMin = MAXX(FILTER(YearlyMin, [TIME] = PrevYear), [MinScore])
			VAR Change = CurrentMin - PrevMin
			RETURN
			    IF(
			        ISBLANK(PrevYear) || ISBLANK(PrevMin),
			        "No earlier year",
			        FORMAT(Change, "+0.00;-0.00;0.00") & " points" & UNICHAR(10) & "(vs " & FORMAT(PrevYear, "0") & ")"
			    )
		lineageTag: 6a49a70f-3dca-428f-b68c-e7e22507949c

	measure 'Average Score Over Time' =
			
