	measure 'Economies Subtitle' =
			VAR SelectedYear =
			    COALESCE(
			        SELECTEDVALUE('OECD PISA data'[Assessment Year]),
			        SELECTEDVALUE('OECD PISA data'[TIME])
			    )
			VAR PrevYear =
			    CALCULATE(
			        MAX('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] < SelectedYear
			    )
			VAR CurrentCount = [Participating Countries Count]
			VAR PrevCount =
			    CALCULATE(
			        [Participating Countries Count],
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] = PrevYear,
			        'OECD PISA data'[Assessment Year] = PrevYear
			    )
			VAR Diff = CurrentCount - PrevCount
			RETURN
			    IF(
			        ISBLANK(SelectedYear) || ISBLANK(PrevYear) || ISBLANK(CurrentCount) || ISBLANK(PrevCount),
			        BLANK(),
			        "vs " & PrevYear & "  " &
			        IF(Diff > 0, "▲ +" & FORMAT(Diff, "#,0"),
			        IF(Diff < 0, "▼ -" & FORMAT(ABS(Diff), "#,0"),
			        "— stable"
			        ))
			    )
		lineageTag: d4f5c6d7-e8a9-0b1c-2d3e-4f5a6b7c8d04

	measure 'Students Subtitle' =
			VAR SelectedYear =
			    COALESCE(
			        SELECTEDVALUE('OECD PISA data'[Assessment Year]),
			        SELECTEDVALUE('OECD PISA data'[TIME])
			    )
			VAR PrevYear =
			    CALCULATE(
			        MAX('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] < SelectedYear
			    )
			VAR CurrentStudents = [Students Assessed]
			VAR PrevStudents =
			    CALCULATE(
			        [Students Assessed],
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] = PrevYear,
			        'OECD PISA data'[Assessment Year] = PrevYear
			    )
			VAR DiffPct = DIVIDE(CurrentStudents - PrevStudents, PrevStudents)
			RETURN
			    IF(
			        ISBLANK(SelectedYear) || ISBLANK(PrevYear) || ISBLANK(CurrentStudents) || ISBLANK(PrevStudents),
			        BLANK(),
			        "vs " & PrevYear & "  " &
			        IF(DiffPct > 0, "▲ +" & FORMAT(DiffPct, "0%"),
			        IF(DiffPct < 0, "▼ -" & FORMAT(ABS(DiffPct), "0%"),
			        "— stable"
			        ))
			    )
		lineageTag: e5f6c7d8-e9a0-1b2c-3d4e-5f6a7b8c9d05

