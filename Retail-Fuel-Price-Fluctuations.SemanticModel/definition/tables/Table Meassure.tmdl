table 'Table Meassure'
	lineageTag: 57d45c8c-534f-4c7c-bb1d-924775fd2f68

	measure 'Overall PISA Score' =
			DIVIDE(
			    [Average Math Score] + [Average Reading Score] + [Average Science Score],
			    3
			)
		formatString: 0
		lineageTag: 6c91d9a4-d5f4-474e-9c3e-af3ffecc79bc

	measure 'Average Math Score' =
			CALCULATE(
			    AVERAGE('OECD PISA data'[Value]),
			    'OECD PISA data'[INDICATOR] = "PISAMATH",
			    'OECD PISA data'[SUBJECT] = "TOT"
			)
		formatString: 0
		lineageTag: f477fd8e-26bd-4bd4-872c-b706fbefc591

	measure 'Average Reading Score' =
			CALCULATE(
			    AVERAGE('OECD PISA data'[Value]),
			    'OECD PISA data'[INDICATOR] = "PISAREAD",
			    'OECD PISA data'[SUBJECT] = "TOT"
			)
		formatString: 0
		lineageTag: 9f235dbd-0aa1-4355-93bd-d8a4329a86cd

	measure 'Average Science Score' =
			CALCULATE(
			    AVERAGE('OECD PISA data'[Value]),
			    'OECD PISA data'[INDICATOR] = "PISASCIENCE",
			    'OECD PISA data'[SUBJECT] = "TOT"
			)
		formatString: 0
		lineageTag: 071c5539-b854-49ba-8d01-2a9b843e318e

	measure 'Selected Subject Score' =
			SWITCH(
			    SELECTEDVALUE('OECD PISA data'[Pisa_Sub]),
			    "Mathematics", [Average Math Score],
			    "Mathematic", [Average Math Score],
			    "Reading", [Average Reading Score],
			    "Science", [Average Science Score],
			    [Overall PISA Score]
			)
		formatString: 0
		lineageTag: 68d4ad88-9e19-4a29-8f77-533f3d6aaba1

	measure 'Overall Average Score' = [Overall PISA Score]
		formatString: 0
		lineageTag: a1102090-4009-4343-8144-bb19db83b997

	measure 'Participating Countries Count' = DISTINCTCOUNT('OECD PISA data'[LOCATION])
		formatString: #,0
		lineageTag: b8c1d2e3-4f5a-6b7c-8d9e-0f1a2b3c4d5e

	measure 'Students Assessed' = SUM(Country_Metadata[Students_Assessed])
		formatString: #,0
		lineageTag: c9d0e1f2-5a6b-7c8d-9e0f-1a2b3c4d5e6f

	measure 'Highest Overall Score' =
			
			VAR CountryAverages =
			    SUMMARIZE(
			        FILTER('OECD PISA data', 'OECD PISA data'[SUBJECT] = "TOT"),
			        'OECD PISA data'[Country Name],
			        "AvgScore", CALCULATE(AVERAGE('OECD PISA data'[Value]))
			    )
			VAR TopRow = TOPN(1, CountryAverages, [AvgScore], DESC)
			VAR MaxCountry = MAXX(TopRow, 'OECD PISA data'[Country Name])
			VAR MaxScore = MAXX(TopRow, [AvgScore])
			RETURN
			    MaxCountry & UNICHAR(10) & FORMAT(MaxScore, "0.00")
		lineageTag: d0e1f2a3-6b7c-8d9e-0f1a-2b3c4d5e6f7a

	measure 'Lowest Overall Score' =
			
			VAR CountryAverages =
			    SUMMARIZE(
			        FILTER('OECD PISA data', 'OECD PISA data'[SUBJECT] = "TOT"),
			        'OECD PISA data'[Country Name],
			        "AvgScore", CALCULATE(AVERAGE('OECD PISA data'[Value]))
			    )
			VAR BottomRow = TOPN(1, CountryAverages, [AvgScore], ASC)
			VAR MinCountry = MAXX(BottomRow, 'OECD PISA data'[Country Name])
			VAR MinScore = MAXX(BottomRow, [AvgScore])
			RETURN
			    MinCountry & UNICHAR(10) & FORMAT(MinScore, "0.00")
		lineageTag: e1f2a3b4-7c8d-9e0f-1a2b-3c4d5e6f7a8b

	measure 'Score Gap' = ```
			
			VAR HighestScore = 
			    CALCULATE(
			        MAXX(
			            SUMMARIZE(
			                FILTER('OECD PISA data', 'OECD PISA data'[SUBJECT] = "TOT"),
			                'OECD PISA data'[Country Name],
			                "AvgScore", CALCULATE(AVERAGE('OECD PISA data'[Value]))
			            ),
			            [AvgScore]
			        )
			    )
			
			VAR LowestScore = 
			    CALCULATE(
			        MINX(
			            SUMMARIZE(
			                FILTER('OECD PISA data', 'OECD PISA data'[SUBJECT] = "TOT"),
			                'OECD PISA data'[Country Name],
			                "AvgScore", CALCULATE(AVERAGE('OECD PISA data'[Value]))
			            ),
			            [AvgScore]
			        )
			    )
			
			RETURN
			    HighestScore - LowestScore
			```
		lineageTag: f2a3b4c5-8d9e-0f1a-2b3c-4d5e6f7a8b9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Change vs 2018' = [Score Change vs Previous Year]
		formatString: 0
		lineageTag: a3b4c5d6-9e0f-1a2b-3c4d-5e6f7a8b9c0e

	measure 'Score Change vs Previous Year' =
			
			VAR SelectedYear =
			    COALESCE(
			        SELECTEDVALUE('OECD PISA data'[Assessment Year]),
			        SELECTEDVALUE('OECD PISA data'[TIME])
			    )
			VAR PrevYear =
			    CALCULATE(
			        MAX('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] < SelectedYear,
			        'OECD PISA data'[Value] > 0
			    )
			VAR CurrentScore = [Selected Subject Score]
			VAR PrevScore =
			    CALCULATE(
			        [Selected Subject Score],
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] = PrevYear,
			        'OECD PISA data'[Assessment Year] = PrevYear
			    )
			RETURN
			    IF(
			        ISBLANK(SelectedYear) || ISBLANK(PrevYear) || ISBLANK(CurrentScore) || ISBLANK(PrevScore) || CurrentScore <= 0 || PrevScore <= 0,
			        BLANK(),
			        ROUND(CurrentScore - PrevScore, 2)
			    )
		formatString: 0
		lineageTag: a3b4c5d6-9e0f-1a2b-3c4d-5e6f7a8b9c0d

	measure 'Reading Score Subtitle' =
			VAR SelectedYear =
			    COALESCE(
			        SELECTEDVALUE('OECD PISA data'[Assessment Year]),
			        SELECTEDVALUE('OECD PISA data'[TIME])
			    )
			VAR PrevYear =
			    CALCULATE(
			        MAX('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] < SelectedYear,
			        'OECD PISA data'[Value] > 0
			    )
			VAR CurrentScore = [Average Reading Score]
			VAR PrevScore =
			    CALCULATE(
			        [Average Reading Score],
			        REMOVEFILTERS('OECD PISA data'[TIME]),
			        REMOVEFILTERS('OECD PISA data'[Assessment Year]),
			        'OECD PISA data'[TIME] = PrevYear,
			        'OECD PISA data'[Assessment Year] = PrevYear
			    )
			VAR Diff = CurrentScore - PrevScore
			RETURN
			    IF(
			        ISBLANK(SelectedYear) || ISBLANK(PrevYear) || ISBLANK(CurrentScore) || ISBLANK(PrevScore) || CurrentScore <= 0 || PrevScore <= 0,
			        BLANK(),
			        "vs " & PrevYear & "  " &
			        IF(ROUND(Diff, 0) > 0, "▲ " & FORMAT(ROUND(Diff, 0), "0") & " pts",
			        IF(ROUND(Diff, 0) < 0, "▼ " & FORMAT(ABS(ROUND(Diff, 0)), "0") & " pts",
			        "— 0 pts"
			        ))
			    )
		lineageTag: a1f2c3d4-e5b6-7a8b-9c0d-1e2f3a4b5c01

